{
  "name": "gltf-sample-viewer-example",
  "version": "1.0.0",
  "description": "The official glTF sample viewer example.",
  "main": "src/main.js",
  "module": "src/main.js",
  "type": "module",
  "scripts": {
    "preinstall": "cd ./glTF-Sample-Renderer && npm install && npm run build",
    "sync:renderer-assets": "mkdir -p public/libs public/assets/images && cp -R glTF-Sample-Renderer/dist/libs/. public/libs/ && cp -R glTF-Sample-Renderer/dist/assets/. public/assets/images/",
    "predev": "cd ./glTF-Sample-Renderer && npm run build && cd .. && npm run sync:renderer-assets",
    "dev": "vite",
    "prebuild": "cd ./glTF-Sample-Renderer && npm run build && cd .. && npm run sync:renderer-assets",
    "build": "vite build",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/**/*.js vite.config.js glTF-Sample-Renderer/source/**/*.js",
    "lint:fix": "eslint --fix src/**/*.js vite.config.js glTF-Sample-Renderer/source/**/*.js",
    "prettier": "npx prettier src/**/*.js glTF-Sample-Renderer/source/**/*.js --check",
    "prettier:fix": "npm run prettier -- --write",
    "format": "npm run prettier:fix && npm run lint:fix",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KhronosGroup/glTF-Sample-Viewer.git"
  },
  "keywords": [
    "gltf",
    "webgl",
    "pbr"
  ],
  "author": "Khronos Group Inc.",
  "license": "Apache-2.0",
  "dependencies": {
    "@khronosgroup/gltf-viewer": "./glTF-Sample-Renderer",
    "@ntohq/buefy-next": "^0.1.3",
    "bulma": "^0.9.4",
    "gltf-validator": "^2.0.0-dev.3.10",
    "normalize-wheel": "^1.0.1",
    "rxjs": "^6.6.7",
    "simple-dropzone": "^0.8.0",
    "vue": "^3.4.29"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "rollup-plugin-license": "^3.5.1",
    "sass": "^1.77.5",
    "vite": "^8.3.0"
  },
  "bugs": {
    "url": "https://github.com/KhronosGroup/glTF-Sample-Viewer/issues"
  },
  "homepage": "https://github.com/KhronosGroup/glTF-Sample-Viewer/#readme"
}
